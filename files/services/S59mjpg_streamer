#!/bin/sh
# Internal Camera Fix Service (Firmware 1.3.5.22 and newer)
# Credit: R_Reis (Creality Forum) & Guilouz

case "$1" in
  start)
    echo "Starting Internal Camera Streamer..."
    i=0
    while [ ! -e /dev/shm/camera_main ] && [ $i -lt 30 ]; do
      sleep 1
      i=$((i+1))
    done
    pidof mjpg_streamer >/dev/null && exit 0
    /usr/bin/mjpg_streamer -b -i "/usr/lib/mjpg-streamer/input_memfd.so -t 0" -o "/usr/lib/mjpg-streamer/output_http.so -p 8080"
    ;;
  stop)
    echo "Stopping Internal Camera Streamer..."
    killall -q mjpg_streamer
    ;;
  restart|reload)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: /etc/init.d/S59mjpg_streamer {start|stop|restart}"
    exit 1
esac

exit 0
